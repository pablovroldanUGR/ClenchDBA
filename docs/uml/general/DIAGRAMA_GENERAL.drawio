          <mxGeometry x="1122" y="1299" width="217.60000000000002" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-162" value="" style="fillColor=#333333;strokeColor=#888888;" parent="1" vertex="1">
          <mxGeometry x="1440" y="1292" width="350" height="58" as="geometry" />
        </mxCell>
        <mxCell id="cell-163" value="Asociación" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1452" y="1299" width="128" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-164" value="" style="rounded=0;arcSize=0;fillColor=#333333;strokeColor=#888888;" parent="1" vertex="1">
          <mxGeometry x="70" y="1500" width="1700" height="276" as="geometry" />
        </mxCell>
        <mxCell id="cell-165" value="Correcciones de la representación" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=19;fontColor=#F0F0F0;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="90" y="1510" width="501.6" height="27" as="geometry" />
        </mxCell>
        <mxCell id="cell-166" value="Se añaden las herencias de GUI → JFrame, AgentTemp/AgentGrid → Agent y BHThermo/BHGrid → Behaviour." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="1547" width="1267.2" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-167" value="La generalización se dibuja con línea continua y triángulo hueco hacia la superclase." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="1574" width="1088" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-168" value="Un import, parámetro, retorno o llamada no convierte una dependencia en una asociación almacenada." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="1601" width="1254.4" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-169" value="«create» expresa la creación del comportamiento; no se inventa un campo BHGrid/BHThermo en el agente." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="1628" width="1292.8000000000002" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-170" value="Environment es abstracta; getInstance(), instance y los miembros de Main se distinguen como estáticos." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="1655" width="1305.6000000000001" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-171" value="Los campos final llevan {readOnly}; no se confunde una referencia final con un objeto inmutable." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="1682" width="1228.8000000000002" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-172" value="Se conserva la visibilidad de paquete (~) de BHGrid.directions y los genéricos de colecciones y Pair&lt;T, U&gt;." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="1709" width="1369.6000000000001" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-173" value="No se cambia el Java para corregir el dibujo: los nombres y las firmas corresponden al código de main." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="90" y="1736" width="1305.6000000000001" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-174" value="" style="rounded=0;arcSize=0;fillColor=#333333;strokeColor=#888888;" parent="1" vertex="1">
          <mxGeometry x="1830" y="190" width="500" height="330" as="geometry" />
        </mxCell>
        <mxCell id="cell-175" value="Dependencias de uso" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=19;fontColor=#F0F0F0;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1850" y="200" width="288.8" height="27" as="geometry" />
        </mxCell>
        <mxCell id="cell-176" value="Main crea los agentes mediante JADE." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="237" width="460.8" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-177" value="Environment crea uno de sus subtipos." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="264" width="473.6" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-178" value="ConexAPI devuelve ResponseLAB." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="291" width="384" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-179" value="Los comportamientos usan su myAgent" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="318" width="448" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-180" value="heredado para acceder al agente concreto." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="345" width="524.8000000000001" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-181" value="GUI llama a Main; Main actualiza GUI." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="372" width="473.6" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-182" value="API, entornos y agentes usan Main" style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="399" width="422.40000000000003" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-183" value="para mensajes y actualizaciones de UI." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="426" width="486.40000000000003" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-184" value="Gson: construcción e interpretación JSON." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="453" width="524.8000000000001" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-185" value="HttpClient: peticiones al servicio DBA Lab." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=16;fontColor=#F0F0F0;fontStyle=0;" parent="1" vertex="1">
          <mxGeometry x="1850" y="480" width="550.4" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cell-186" value="Las firmas de métodos también expresan dependencias de uso con sus parámetros y retornos." style="text;html=0;whiteSpace=wrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=DejaVu Sans;fontSize=17;fontColor=#B8B8B8;fontStyle=0;" parent="1" vertex="1">
